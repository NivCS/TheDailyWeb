<header class="site-header">
  <a class="brand" href="/" aria-label="The Daily Web home">
    <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="brand-name">the daily<span>web</span></span>
  </a>
  <nav class="main-nav" aria-label="Main navigation">
    <% if (currentUser) { %>
      <% if (currentUser.role === 'reporter') { %>
        <a href="/reporter/articles" class="nav-link">My articles</a>
        <a href="/reporter/articles/new" class="nav-link">New article</a>
      <% } else { %>
        <a href="/editor/articles" class="nav-link">All articles</a>
        <a href="/editor/articles?status=pending" class="nav-link">Review queue</a>
        <a href="/editor/analytics" class="nav-link">Impact analytics</a>
      <% } %>
    <% } else { %>
      <a href="/" class="nav-link is-active" data-home-link>Home</a>
      <a href="/?category=World" class="nav-link" data-category-link="World">World</a>
      <a href="/?category=Technology" class="nav-link" data-category-link="Technology">Technology</a>
      <a href="/?category=Business" class="nav-link" data-category-link="Business">Business</a>
      <a href="/?category=Culture" class="nav-link" data-category-link="Culture">Culture</a>
      <a href="/?category=Climate" class="nav-link" data-category-link="Climate">Climate</a>
    <% } %>
  </nav>
  <% if (currentUser) { %>
    <div class="account-menu">
      <button class="header-action account-menu-toggle" id="account-menu-toggle" type="button" aria-label="Open account menu for <%= currentUser.username %>" aria-expanded="false" aria-controls="account-dropdown">
        <span class="account-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.25"></circle><path d="M5.5 19c.55-3.25 2.9-5 6.5-5s5.95 1.75 6.5 5"></path></svg></span>
        <span class="account-menu-caret" aria-hidden="true"><svg viewBox="0 0 16 16" focusable="false"><path d="m4 6 4 4 4-4"></path></svg></span>
      </button>
      <section class="account-dropdown" id="account-dropdown" aria-label="Account menu" hidden>
        <div class="account-profile">
          <span class="account-avatar account-profile-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="3.25"></circle><path d="M5.5 19c.55-3.25 2.9-5 6.5-5s5.95 1.75 6.5 5"></path></svg></span>
          <div class="account-profile-copy">
            <p class="account-dropdown-greeting">Hello, <strong><%= currentUser.username %></strong></p>
            <span class="account-role-badge"><%= currentUser.role === 'editor' ? 'Editor' : 'Reporter' %></span>
          </div>
        </div>
        <div class="account-dropdown-divider" role="separator"></div>
        <a class="account-dropdown-item" href="<%= currentUser.role === 'editor' ? '/editor' : '/reporter' %>">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 5.5 8 2l6 3.5v7a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z"></path><path d="M6 13.5v-4h4v4"></path></svg>
          <span>Open my workspace</span><span class="account-item-arrow" aria-hidden="true">↗</span>
        </a>
        <div class="account-dropdown-divider" role="separator"></div>
        <form action="/logout" method="post"><button class="account-dropdown-item account-signout" type="submit">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2.5H3.5a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1H6"></path><path d="M9.5 11.5 13 8l-3.5-3.5M13 8H5"></path></svg>
          <span>Sign out</span>
        </button></form>
      </section>
    </div>
  <% } else { %>
    <a class="header-action sign-in-action" href="/login">Sign in <span aria-hidden="true">↗</span></a>
  <% } %>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>
</header>
<script defer src="/assets/js/header.js?v=2"></script>
